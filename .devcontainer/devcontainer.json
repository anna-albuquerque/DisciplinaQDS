{
  "name": "Java with Maven DevContainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "settings": {
    "java.home": "/usr/lib/jvm/java-17-openjdk-amd64",
    "java.configuration.runtimes": [
      {
        "name": "JavaSE-17",
        "path": "/usr/lib/jvm/java-17-openjdk-amd64",
        "default": true
      }
    ]
  },
  "extensions": [
    "vscjava.vscode-java-pack",      // Extensões do Java para VS Code
    "redhat.java",
    "mhutchie.git-graph",
    "ms-azuretools.vscode-docker"
  ],
  "postCreateCommand": "mvn clean install", // Comando para rodar após criar o container
  "forwardPorts": [],
  "remoteUser": "vscode",
  "mounts": [
    "source=/root/.m2,target=/home/vscode/.m2,type=bind" // Cache para dependências Maven
  ],
  "remoteEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64"
  }
}
